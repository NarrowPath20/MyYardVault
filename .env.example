# Local mode saves leads without sending SMS. Copy this file to .env.
TWILIO_NOTIFICATIONS_ENABLED=false
LEAD_DATA_DIR=.data/leads
PORT=3000

# Fill these in only when the client's account and team recipient are ready.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Use a Messaging Service instead of FROM_NUMBER if preferred.
TWILIO_MESSAGING_SERVICE_SID=
LEAD_TEAM_PHONE=
# Public HTTPS origin, for example https://www.myyardvault.com
PUBLIC_BASE_URL=
